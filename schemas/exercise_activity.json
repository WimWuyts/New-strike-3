{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://newace-newstrike.local/schemas/exercise_activity.json",
  "title": "ExerciseActivity",
  "description": "Eén afgeronde interactieve activiteit met eigen leerdoel, instructie, stimulus, feedbacklogica en 3-8 betekenisvolle antwoordmomenten.",
  "type": "object",
  "unevaluatedProperties": false,
  "allOf": [{ "$ref": "common.json#/$defs/entityBase" }],
  "required": [
    "target_id",
    "target_kind",
    "stage",
    "difficulty",
    "interaction_type",
    "instructions",
    "stimulus",
    "prompts"
  ],
  "properties": {
    "kind": { "const": "exercise_activity" },
    "provenance": { "const": "original_companion" },

    "target_id": {
      "$ref": "common.json#/$defs/slug",
      "description": "ID van het grammaticaonderwerp of de woordenschatset."
    },
    "target_kind": {
      "type": "string",
      "enum": ["grammar_topic", "vocabulary_set"]
    },
    "stage": { "type": "integer", "minimum": 1, "maximum": 5 },
    "sequence": { "type": "integer", "minimum": 1, "maximum": 25 },
    "difficulty": {
      "type": "string",
      "enum": ["support", "core", "challenge"]
    },
    "interaction_type": { "$ref": "common.json#/$defs/slug" },

    "instructions": {
      "allOf": [{ "$ref": "common.json#/$defs/nonEmptyText" }],
      "minLength": 10,
      "maxLength": 600
    },

    "stimulus": {
      "type": "object",
      "unevaluatedProperties": false,
      "required": ["type", "content"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["text", "dialogue", "list", "image_description", "table", "audio_script"]
        },
        "content": { "$ref": "common.json#/$defs/nonEmptyText" },
        "context_note": { "type": "string" }
      }
    },

    "prompts": {
      "type": "array",
      "minItems": 3,
      "maxItems": 8,
      "description": "De betekenisvolle antwoordmomenten van deze activiteit.",
      "items": {
        "type": "object",
        "unevaluatedProperties": false,
        "required": ["id", "prompt", "response_mode"],
        "properties": {
          "id": { "$ref": "common.json#/$defs/slug" },
          "prompt": { "$ref": "common.json#/$defs/nonEmptyText" },
          "response_mode": {
            "type": "string",
            "enum": [
              "typed_short",
              "typed_sentence",
              "typed_paragraph",
              "multiple_choice",
              "select_multiple",
              "ordering",
              "matching",
              "drag_to_zone",
              "click_to_mark"
            ]
          },
          "options": {
            "type": "array",
            "minItems": 2,
            "items": { "$ref": "common.json#/$defs/nonEmptyText" },
            "description": "Verplicht bij keuzegebaseerde response_modes."
          },
          "canonical_answers": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "common.json#/$defs/nonEmptyText" }
          },
          "accepted_variants": {
            "type": "array",
            "items": { "$ref": "common.json#/$defs/nonEmptyText" }
          },
          "normalization_rules": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "typographic_apostrophes",
                "collapse_whitespace",
                "trim",
                "ignore_case",
                "ignore_terminal_punctuation"
              ]
            }
          },
          "evidence_ref": {
            "type": "string",
            "description": "Verwijzing naar het deel van de stimulus dat het antwoord bewijst. Verplicht wanneer het antwoord uit de stimulus volgt."
          },
          "error_feedback": {
            "type": "array",
            "items": {
              "type": "object",
              "unevaluatedProperties": false,
              "required": ["matches", "feedback"],
              "properties": {
                "matches": { "type": "string", "minLength": 1 },
                "match_kind": {
                  "type": "string",
                  "enum": ["exact", "regex", "contains"],
                  "default": "exact"
                },
                "feedback": {
                  "allOf": [{ "$ref": "common.json#/$defs/nonEmptyText" }],
                  "minLength": 10
                }
              }
            }
          },
          "hints": {
            "type": "array",
            "maxItems": 3,
            "items": {
              "allOf": [{ "$ref": "common.json#/$defs/nonEmptyText" }],
              "minLength": 5
            },
            "description": "Progressief: van sturend naar concreet. Geeft het antwoord niet weg."
          },
          "manual_review_rubric": {
            "type": ["object", "null"],
            "unevaluatedProperties": false,
            "required": ["criteria"],
            "properties": {
              "criteria": {
                "type": "array",
                "minItems": 2,
                "items": {
                  "type": "object",
                  "unevaluatedProperties": false,
                  "required": ["label", "descriptor"],
                  "properties": {
                    "label": { "type": "string", "minLength": 2 },
                    "descriptor": { "type": "string", "minLength": 10 },
                    "weight": { "type": "number", "minimum": 0, "maximum": 1 }
                  }
                }
              },
              "model_response": { "type": "string", "minLength": 10 }
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "response_mode": {
                  "enum": ["multiple_choice", "select_multiple", "matching", "ordering", "drag_to_zone", "click_to_mark"]
                }
              },
              "required": ["response_mode"]
            },
            "then": { "required": ["options", "canonical_answers"] }
          },
          {
            "if": {
              "properties": {
                "response_mode": { "enum": ["typed_short", "typed_sentence"] }
              },
              "required": ["response_mode"]
            },
            "then": { "required": ["canonical_answers"] }
          },
          {
            "if": {
              "properties": {
                "response_mode": { "const": "typed_paragraph" }
              },
              "required": ["response_mode"]
            },
            "then": {
              "required": ["manual_review_rubric"],
              "properties": { "manual_review_rubric": { "type": "object" } }
            }
          }
        ]
      }
    },

    "source_refs": {
      "type": "array",
      "items": { "$ref": "common.json#/$defs/sourcePageRef" }
    }
  }
}
