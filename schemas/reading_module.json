{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://newace-newstrike.local/schemas/reading_module.json",
  "title": "ReadingModule",
  "type": "object",
  "unevaluatedProperties": false,
  "allOf": [
    {
      "$ref": "common.json#/$defs/entityBase"
    }
  ],
  "required": [
    "variant",
    "text_type",
    "text",
    "tasks",
    "answer_model",
    "topic_id"
  ],
  "properties": {
    "kind": {
      "const": "reading"
    },
    "provenance": {
      "const": "original_companion"
    },
    "topic_id": {
      "$ref": "common.json#/$defs/slug",
      "description": "Koppelt de twee niveauvarianten van hetzelfde onderwerp aan elkaar, zodat de leerkracht ze naast elkaar kan inzetten."
    },
    "variant": {
      "type": "string",
      "enum": [
        "core",
        "challenge"
      ]
    },
    "text_type": {
      "type": "string",
      "enum": [
        "article",
        "blog",
        "interview",
        "review",
        "message",
        "advertisement",
        "instructions",
        "short_story",
        "email",
        "report"
      ]
    },
    "word_count": {
      "type": "integer",
      "minimum": 80
    },
    "text": {
      "type": "object",
      "unevaluatedProperties": false,
      "required": [
        "title_en",
        "paragraphs"
      ],
      "properties": {
        "title_en": {
          "$ref": "common.json#/$defs/nonEmptyText"
        },
        "paragraphs": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "unevaluatedProperties": false,
            "required": [
              "id",
              "sentences"
            ],
            "properties": {
              "id": {
                "$ref": "common.json#/$defs/slug"
              },
              "sentences": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "unevaluatedProperties": false,
                  "required": [
                    "id",
                    "text_en"
                  ],
                  "properties": {
                    "id": {
                      "$ref": "common.json#/$defs/slug"
                    },
                    "text_en": {
                      "$ref": "common.json#/$defs/nonEmptyText"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "tasks": {
      "type": "object",
      "unevaluatedProperties": false,
      "required": [
        "gist",
        "detail",
        "inference",
        "vocabulary_in_context",
        "post_reading"
      ],
      "properties": {
        "pre_reading": {
          "$ref": "#/$defs/taskGroup"
        },
        "gist": {
          "$ref": "#/$defs/taskGroup"
        },
        "detail": {
          "$ref": "#/$defs/taskGroup"
        },
        "inference": {
          "$ref": "#/$defs/taskGroup"
        },
        "vocabulary_in_context": {
          "$ref": "#/$defs/taskGroup"
        },
        "post_reading": {
          "type": "object",
          "unevaluatedProperties": false,
          "required": [
            "prompt",
            "rubric"
          ],
          "description": "Eén transfertaak.",
          "properties": {
            "prompt": {
              "type": "string",
              "minLength": 20
            },
            "rubric": {
              "type": "array",
              "minItems": 2,
              "items": {
                "type": "object",
                "unevaluatedProperties": false,
                "required": [
                  "label",
                  "descriptor"
                ],
                "properties": {
                  "label": {
                    "type": "string",
                    "minLength": 2
                  },
                  "descriptor": {
                    "type": "string",
                    "minLength": 10
                  }
                }
              }
            }
          }
        }
      }
    },
    "answer_model": {
      "type": "string",
      "minLength": 20
    },
    "differentiation": {
      "type": "object",
      "unevaluatedProperties": false,
      "properties": {
        "support": {
          "type": "string",
          "minLength": 10
        },
        "challenge": {
          "type": "string",
          "minLength": 10
        }
      }
    },
    "images": {
      "type": "array",
      "items": {
        "type": "object",
        "unevaluatedProperties": false,
        "required": [
          "path",
          "alt_nl",
          "rights"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "alt_nl": {
            "type": "string",
            "minLength": 5
          },
          "rights": {
            "type": "string",
            "enum": [
              "self_made",
              "public_domain",
              "cc0",
              "licensed"
            ]
          }
        }
      }
    }
  },
  "$defs": {
    "taskGroup": {
      "type": "object",
      "unevaluatedProperties": false,
      "required": [
        "questions"
      ],
      "properties": {
        "instructions": {
          "type": "string",
          "minLength": 10
        },
        "questions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "unevaluatedProperties": false,
            "required": [
              "id",
              "question",
              "response_mode",
              "canonical_answers",
              "evidence_ref"
            ],
            "properties": {
              "id": {
                "$ref": "common.json#/$defs/slug"
              },
              "question": {
                "$ref": "common.json#/$defs/nonEmptyText"
              },
              "response_mode": {
                "type": "string",
                "enum": [
                  "typed_short",
                  "typed_sentence",
                  "multiple_choice",
                  "true_false",
                  "matching",
                  "ordering"
                ]
              },
              "options": {
                "type": "array",
                "minItems": 2,
                "items": {
                  "$ref": "common.json#/$defs/nonEmptyText"
                }
              },
              "canonical_answers": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "$ref": "common.json#/$defs/nonEmptyText"
                }
              },
              "accepted_variants": {
                "type": "array",
                "items": {
                  "$ref": "common.json#/$defs/nonEmptyText"
                }
              },
              "evidence_ref": {
                "type": "string",
                "minLength": 1,
                "description": "ID van de zin of alinea die het antwoord bewijst."
              },
              "feedback": {
                "type": "string",
                "minLength": 10
              }
            }
          }
        }
      }
    }
  }
}
