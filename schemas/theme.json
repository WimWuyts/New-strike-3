{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://newace-newstrike.local/schemas/theme.json",
  "title": "Theme",
  "type": "object",
  "unevaluatedProperties": false,
  "required": [
    "id",
    "book_id",
    "unit",
    "title",
    "cefr",
    "source_file",
    "page_range",
    "sections",
    "grammar_topic_ids",
    "vocabulary_set_ids",
    "review_status"
  ],
  "properties": {
    "id": { "$ref": "common.json#/$defs/themeId" },
    "book_id": { "$ref": "common.json#/$defs/bookId" },
    "unit": { "type": "integer", "minimum": 1 },
    "title": { "$ref": "common.json#/$defs/nonEmptyText" },
    "title_confidence": { "$ref": "common.json#/$defs/confidence" },
    "cefr": { "$ref": "common.json#/$defs/cefr" },

    "source_file": { "type": "string", "minLength": 1 },
    "page_range": {
      "type": "object",
      "unevaluatedProperties": false,
      "required": ["first", "last"],
      "properties": {
        "first": { "type": "integer", "minimum": 1 },
        "last": { "type": "integer", "minimum": 1 }
      }
    },

    "sections": {
      "type": "array",
      "minItems": 1,
      "description": "Gedetecteerde rubrieken binnen het thema.",
      "items": {
        "type": "object",
        "unevaluatedProperties": false,
        "required": ["kind", "first_page", "last_page", "detection_confidence"],
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "theme_opener", "vocabulary", "grammar", "reading",
              "listening", "speaking", "writing", "exercises",
              "review", "reference", "unknown"
            ]
          },
          "label": { "type": "string" },
          "first_page": { "type": "integer", "minimum": 1 },
          "last_page": { "type": "integer", "minimum": 1 },
          "detection_confidence": { "$ref": "common.json#/$defs/confidence" }
        }
      }
    },

    "grammar_topic_ids": {
      "type": "array",
      "items": { "$ref": "common.json#/$defs/slug" }
    },
    "vocabulary_set_ids": {
      "type": "array",
      "items": { "$ref": "common.json#/$defs/slug" }
    },
    "reading_ids": {
      "type": "array",
      "items": { "$ref": "common.json#/$defs/slug" }
    },
    "listening_ids": {
      "type": "array",
      "items": { "$ref": "common.json#/$defs/slug" }
    },

    "open_questions": {
      "type": "array",
      "description": "Onzekerheden die naar de manual review queue gaan.",
      "items": {
        "type": "object",
        "unevaluatedProperties": false,
        "required": ["question_nl", "page"],
        "properties": {
          "question_nl": { "type": "string", "minLength": 10 },
          "page": { "type": "integer", "minimum": 1 },
          "crop_path": { "type": "string" }
        }
      }
    },

    "review_status": { "$ref": "common.json#/$defs/reviewStatus" }
  }
}
