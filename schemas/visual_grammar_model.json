{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://newace-newstrike.local/schemas/visual_grammar_model.json",
  "title": "VisualGrammarModel",
  "description": "Storyboard van 4-8 stappen. Per stap één betekenisvolle verandering.",
  "type": "object",
  "unevaluatedProperties": false,
  "allOf": [{ "$ref": "common.json#/$defs/entityBase" }],
  "required": ["grammar_topic_id", "model_type", "steps", "accessibility"],
  "properties": {
    "kind": { "const": "visual_grammar_model" },
    "provenance": { "const": "original_companion" },

    "grammar_topic_id": { "$ref": "common.json#/$defs/slug" },

    "model_type": {
      "type": "string",
      "enum": ["timeline", "contrast_diagram", "word_tiles", "decision_tree", "substitution_table"]
    },

    "steps": {
      "type": "array",
      "minItems": 4,
      "maxItems": 8,
      "items": {
        "type": "object",
        "unevaluatedProperties": false,
        "required": ["index", "caption_nl", "change_description_nl", "elements"],
        "properties": {
          "index": { "type": "integer", "minimum": 1, "maximum": 8 },
          "caption_nl": { "type": "string", "minLength": 10 },
          "change_description_nl": {
            "type": "string",
            "minLength": 10,
            "description": "De ene betekenisvolle verandering die deze stap toont."
          },
          "elements": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "unevaluatedProperties": false,
              "required": ["id", "text", "role", "state"],
              "properties": {
                "id": { "$ref": "common.json#/$defs/slug" },
                "text": { "type": "string", "minLength": 1 },
                "role": {
                  "type": "string",
                  "enum": ["subject", "aux", "verb", "time", "negation", "object", "complement"]
                },
                "state": {
                  "type": "string",
                  "enum": ["present", "entering", "moving", "highlighted", "removed", "dimmed"]
                },
                "position": {
                  "type": "object",
                  "unevaluatedProperties": false,
                  "required": ["order"],
                  "properties": {
                    "order": { "type": "integer", "minimum": 0 },
                    "row": { "type": "integer", "minimum": 0 }
                  }
                }
              }
            }
          }
        }
      }
    },

    "accessibility": {
      "type": "object",
      "unevaluatedProperties": false,
      "required": ["static_alternative_nl", "role_legend"],
      "properties": {
        "static_alternative_nl": {
          "type": "string",
          "minLength": 30,
          "description": "Volwaardig tekstalternatief voor wie de animatie niet ziet of uitzet."
        },
        "role_legend": {
          "type": "array",
          "minItems": 1,
          "description": "Kleur is nooit de enige informatiedrager: elke rol krijgt ook een label en vorm.",
          "items": {
            "type": "object",
            "unevaluatedProperties": false,
            "required": ["role", "label", "shape"],
            "properties": {
              "role": { "type": "string" },
              "label": { "type": "string", "minLength": 1 },
              "shape": {
                "type": "string",
                "enum": ["rounded_rect", "rect", "pill", "clock", "hexagon", "diamond", "strikethrough_badge"]
              },
              "pattern": { "type": "string" }
            }
          }
        }
      }
    },

    "pptx_progressive_slides": {
      "type": "integer",
      "minimum": 4,
      "maximum": 8,
      "description": "Aantal duplicaatslides voor de progressieve reveal."
    },

    "embedded_motion": {
      "type": "object",
      "unevaluatedProperties": false,
      "required": ["status"],
      "properties": {
        "status": { "$ref": "common.json#/$defs/buildStatus" },
        "format": { "type": ["string", "null"], "enum": ["gif", "mp4", null] },
        "path": { "type": ["string", "null"] },
        "loops_correctly": { "type": ["boolean", "null"] }
      }
    }
  }
}
