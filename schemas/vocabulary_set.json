{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://newace-newstrike.local/schemas/vocabulary_set.json",
  "title": "VocabularySet",
  "type": "object",
  "unevaluatedProperties": false,
  "allOf": [{ "$ref": "common.json#/$defs/entityBase" }],
  "required": ["lexemes"],
  "properties": {
    "kind": { "const": "vocabulary_set" },
    "topic_label_nl": { "type": "string", "minLength": 2 },
    "lexemes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/lexeme" }
    },
    "changelog": {
      "type": "array",
      "description": "Elke afwijking van de bron. Nooit stilzwijgend corrigeren.",
      "items": {
        "type": "object",
        "unevaluatedProperties": false,
        "required": ["lexeme_id", "field", "source_value", "new_value", "reason_nl"],
        "properties": {
          "lexeme_id": { "$ref": "common.json#/$defs/slug" },
          "field": { "type": "string", "minLength": 1 },
          "source_value": { "type": "string" },
          "new_value": { "type": "string" },
          "reason_nl": { "type": "string", "minLength": 10 }
        }
      }
    }
  },
  "$defs": {
    "lexeme": {
      "type": "object",
      "unevaluatedProperties": false,
      "required": [
        "id",
        "lemma",
        "part_of_speech",
        "definition_en",
        "translation_nl",
        "example_sentences",
        "provenance"
      ],
      "properties": {
        "id": { "$ref": "common.json#/$defs/slug" },
        "lemma": { "$ref": "common.json#/$defs/nonEmptyText" },
        "learnable_form": {
          "type": "string",
          "description": "De vorm zoals de leerling die moet kunnen schrijven, als die van het lemma verschilt."
        },
        "part_of_speech": {
          "type": "string",
          "enum": [
            "noun", "verb", "adjective", "adverb", "preposition",
            "conjunction", "pronoun", "determiner", "interjection",
            "phrasal_verb", "collocation", "chunk", "idiom"
          ]
        },
        "ipa": { "type": "string" },
        "stress_pattern": { "type": "string" },
        "definition_en": {
          "allOf": [{ "$ref": "common.json#/$defs/nonEmptyText" }],
          "minLength": 8,
          "maxLength": 200,
          "description": "Kort en leerlingvriendelijk."
        },
        "translation_nl": { "$ref": "common.json#/$defs/nonEmptyText" },
        "collocations": {
          "type": "array",
          "items": { "$ref": "common.json#/$defs/nonEmptyText" }
        },
        "example_sentences": {
          "type": "array",
          "minItems": 1,
          "items": {
            "allOf": [{ "$ref": "common.json#/$defs/nonEmptyText" }],
            "minLength": 10
          },
          "description": "Volledig origineel, niet uit de bron overgenomen."
        },
        "word_family": {
          "type": "array",
          "items": {
            "type": "object",
            "unevaluatedProperties": false,
            "required": ["form", "part_of_speech"],
            "properties": {
              "form": { "$ref": "common.json#/$defs/nonEmptyText" },
              "part_of_speech": { "type": "string" }
            }
          }
        },
        "register": {
          "type": "string",
          "enum": ["neutral", "informal", "formal", "slang", "academic", "technical"]
        },
        "common_confusion": {
          "type": "object",
          "unevaluatedProperties": false,
          "required": ["with", "note_nl"],
          "properties": {
            "with": { "type": "string", "minLength": 1 },
            "note_nl": { "type": "string", "minLength": 10 }
          }
        },
        "cefr": { "$ref": "common.json#/$defs/cefr" },
        "cefr_confidence": { "$ref": "common.json#/$defs/confidence" },
        "provenance": { "$ref": "common.json#/$defs/provenance" },
        "source_page_refs": {
          "type": "array",
          "items": { "$ref": "common.json#/$defs/sourcePageRef" }
        }
      },
      "allOf": [
        {
          "comment": "Bronwoorden moeten een paginaverwijzing hebben.",
          "if": {
            "properties": { "provenance": { "enum": ["source_core", "corrected_source"] } },
            "required": ["provenance"]
          },
          "then": {
            "required": ["source_page_refs"],
            "properties": {
              "source_page_refs": { "minItems": 1 }
            }
          }
        }
      ]
    }
  }
}
